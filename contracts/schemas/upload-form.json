{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://post-history/contracts/schemas/upload-form.json",
  "title": "UploadForm",
  "description": "نموذج الرفع الديناميكي الذي تضبطه الإدارة. هذه المجموعة الفرعية المسموحة وحدها ترسمها الواجهات الثلاث (الويب، iOS، أندرويد) ويتحقق بها الخادم.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "fields"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "material_types": {
      "description": "أنواع المواد التي يظهر معها هذا النموذج؛ فارغ = الكل",
      "type": "array",
      "items": { "type": "string" }
    },
    "fields": {
      "type": "array",
      "items": { "$ref": "#/$defs/field" }
    }
  },
  "$defs": {
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ar", "en"],
      "properties": {
        "ar": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "condition": {
      "description": "يظهر الحقل فقط حين يساوي حقل آخر قيمة محددة",
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "equals"],
      "properties": {
        "field": { "type": "string" },
        "equals": { "type": ["string", "number", "boolean"] }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "label", "required"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
        "type": {
          "type": "string",
          "enum": [
            "short_text",
            "long_text",
            "number",
            "select",
            "multi_select",
            "datetime",
            "location",
            "boolean",
            "staff_member",
            "attachment"
          ]
        },
        "label": { "$ref": "#/$defs/localized" },
        "help": { "$ref": "#/$defs/localized" },
        "required": { "type": "boolean" },
        "sensitive": {
          "description": "يُشفَّر على مستوى الحقل ولا يُعرض خارج الأدوار المخوّلة",
          "type": "boolean",
          "default": false
        },
        "searchable": {
          "description": "تطلب الإدارة ترقيته إلى فهرس تعبيري أو عمود مُولَّد",
          "type": "boolean",
          "default": false
        },
        "default": {},
        "material_types": { "type": "array", "items": { "type": "string" } },
        "condition": { "$ref": "#/$defs/condition" },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min_length": { "type": "integer", "minimum": 0 },
            "max_length": { "type": "integer", "minimum": 1 },
            "min": { "type": "number" },
            "max": { "type": "number" },
            "pattern": { "type": "string" },
            "options": {
              "description": "لـ select و multi_select",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["value", "label"],
                "properties": {
                  "value": { "type": "string" },
                  "label": { "$ref": "#/$defs/localized" }
                }
              }
            },
            "max_items": { "type": "integer", "minimum": 1 },
            "accept": {
              "description": "أنواع MIME المقبولة للمرفق",
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
