# انسخ هذا الملف إلى .env (لا يُرفع إلى المستودع) وعدّل القيم محليًا.
# هذه قيم تطوير محلية فقط؛ قيم الإنتاج في خزنة الأسرار، لا هنا.

POSTGRES_DB=posthistory
POSTGRES_USER=posthistory
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

REDIS_PORT=6379
REDIS_PASSWORD=change-me-locally

# MinIO محليًا؛ في الإنتاج: R2 عبر <ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=http://minio:9000
# العنوان الذي يصل منه العملاء إلى MinIO وتُوقَّع له روابط التنزيل، مثل http://127.0.0.1:9000 محليًا أو اسم التخزين العام
# على مضيف التجربة. فارغ = S3_ENDPOINT (اسم minio الداخلي، لا يعمل خارج compose).
S3_PUBLIC_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=minio-local
S3_SECRET_KEY=change-me-locally
S3_BUCKET_UPLOADS=uploads
S3_BUCKET_MEDIA=media
S3_PORT=9000
S3_CONSOLE_PORT=9001

# tusd — R2 يشترط تساوي الأجزاء وحدًا أدنى 5 MiB؛ 16 MiB افتراضيًا هنا ويُثبَّت بعد نموذج الرفع
TUSD_PORT=8080
TUSD_PART_SIZE_BYTES=16777216
TUSD_DISABLE_CONTENT_HASHES=false
# بادئة مفاتيح الرفع في الحاوية؛ يقرؤها الخادم بالاسم نفسه (apps/api) ليطابق مفتاح التخزين
TUSD_OBJECT_PREFIX=tus/
# tusd يرسل post-create؛ الخادم ينقل الجلسة إلى in_progress عنده، ويحجزها ذريًا في pre-create
# (TUSD_PRE_CREATE_RESERVATION_SECONDS) فلا يُقبل إنشاء ثانٍ بالرمز نفسه. tusd لا يرفض المعرّف المكرّر (SEC-06)،
# فهذا الحجز هو الضمان، ويثبته infra/compose/e2e-duplicate-create.mjs في CI.
TUSD_POST_CREATE_HOOK=true
# خطّاف tusd (ADR SEC-06): العنوان النهائي = TUSD_HOOK_URL/TUSD_HOOK_SECRET على شبكة compose الداخلية "hooks".
# الرمز 32–128 حرفًا من [A-Za-z0-9_-]، يُولَّد في .env وحده: openssl rand -hex 32
# فارغ هنا عمدًا: compose يرفض البدء بلا رمز.
TUSD_HOOK_URL=http://api:3000/internal/tusd-hooks
TUSD_HOOK_SECRET=
# عنوان tusd ثابت في compose على شبكة hooks (172.30.250.0/29). الخادم يقبل /internal/* منه وحده
# (INTERNAL_ALLOWED_CIDRS في apps/api)، لا من الشبكة كلها.
# وعامل الوسائط ثابت على شبكة media (172.30.251.2، ADR 0006)، وعامل التفريغ المحلي عليها (172.30.251.3، ADR 0019)
INTERNAL_ALLOWED_CIDRS=172.30.250.2/32,172.30.251.2/32,172.30.251.3/32
# أعلام إضافية لـ tusd. محليًا فارغة؛ خلف Cloudflare/nginx فقط: -behind-proxy
TUSD_EXTRA_FLAGS=

# الخادم (apps/api) في compose، اختياري: docker compose --profile api up -d --wait
# REDIS_URL وDATABASE_URL وS3_* تُبنى في compose من القيم أعلاه. القيمتان التاليتان تُولَّدان في .env:
#   JWT_SECRET:            openssl rand -hex 32
#   FIELD_ENCRYPTION_KEY:  openssl rand -base64 32
API_PORT=3000
JWT_SECRET=
FIELD_ENCRYPTION_KEY=

# التدوير والطوارئ (docs/ops/runbook.md). فارغ = غير مضبوط لدى الخادم.
# الرمز السابق لخطّاف tusd يُقبل حتى وقت ISO 8601، ثم يُرفض وحده دون إعادة تشغيل
TUSD_HOOK_SECRET_PREVIOUS=
TUSD_HOOK_SECRET_PREVIOUS_UNTIL=
# مفتاح الحقول برقم إصدار، والسابق مع إصداره أثناء إعادة التشفير
FIELD_ENCRYPTION_KEY_VERSION=
FIELD_ENCRYPTION_KEY_PREVIOUS=
FIELD_ENCRYPTION_KEY_PREVIOUS_VERSION=
# بصمة SHA-256 لرمز الخزنة (طريق vault لأمر الاستعادة الطارئة)؛ الرمز نفسه لا يُخزَّن هنا
BREAK_GLASS_TOKEN_SHA256=
# عامل الوسائط (ADR 0006). الرمز ≥ 32 من [A-Za-z0-9_-] (openssl rand -hex 32)، منفصل عن TUSD_HOOK_SECRET.
# مستخدم MinIO مستقل للعامل: قراءة على حاوية الرفع/TUSD_OBJECT_PREFIX، وكتابة على حاوية الوسائط/derived/ فقط.
# في الإنتاج من SOPS كباقي الأسرار (SEC-05). فارغ = لا يُنشأ المستخدم.
MEDIA_WORKER_TOKEN=
# in_process (افتراضي، فارغ) أو external مع profile media: الخادم ينشر أحداث الاستلام لعامل الوسائط
UPLOAD_VERIFIER=
S3_MEDIA_ACCESS_KEY=
S3_MEDIA_SECRET_KEY=
# مستخدم MinIO للنسخ الاحتياطي (ADR 0013): قراءة فقط على الحاويتين. فارغ = لا يُنشأ.
S3_BACKUP_ACCESS_KEY=
S3_BACKUP_SECRET_KEY=
# شهادة الجهاز ورمز ingest (ADR 0011). فارغ = off. test للتطوير وCI فقط (يرفضه الخادم في الإنتاج).
ATTESTATION_MODE=
APP_ATTEST_APP_ID=
APP_ATTEST_TEST_ROOT_PEM=
PLAY_INTEGRITY_PACKAGE_NAME=
PLAY_INTEGRITY_CERT_SHA256=
# المفتاح الخاص لتوقيع رموز ingest (PKCS#8 DER بـ base64، من SOPS) ومعرّفه kid؛ البوابة تحمل العام بالمعرّف نفسه
INGEST_TOKEN_SIGNING_KEY=
INGEST_TOKEN_KEY_ID=
INGEST_REQUIRED=
INGEST_TUS_ENDPOINT=
# عامل الذكاء الاصطناعي المحلي (profile ai، ADR 0019): الأوزان من infra/ai/models.lock بالبصمة، والحدود كعامل الوسائط.
AI_MODELS=ggml-large-v3-turbo-q5_0
AI_MODEL=ggml-large-v3-turbo-q5_0
AI_WORKER_CPUS=2
AI_WORKER_MEM_LIMIT=4g
