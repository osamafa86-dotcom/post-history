# متغيرات المعاينة الخفيفة (ADR 0023). معاينة فقط، لا تُنقل إلى التجربة. لا قيمة هنا: gen-env.sh يولّد .env بجانب هذا الملف
# مرة على الخادم (أسرار عشوائية، صلاحية 0600، لا تُطبع)، وseed-preview.sh يضيف كلمات سر الحسابات التجريبية إليه.
# النطاق في .env وحده: المستودع عام، فلا اسم نطاق ولا عنوان خادم فيه.
PREVIEW_DOMAIN=

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_UPLOADS=
S3_BUCKET_MEDIA=
JWT_SECRET=
FIELD_ENCRYPTION_KEY=
TUSD_HOOK_SECRET=
WEB_SESSION_KEY=
# الرفع من الحاسوب: مفتاح توقيع رمز ingest (ES256، PKCS#8 base64) ومفتاحه العام للبوابة (kid:SPKI)، وسر البوابة نحو الخادم
INGEST_TOKEN_SIGNING_KEY=
INGEST_TOKEN_KEY_ID=
INGEST_TOKEN_PUBLIC_KEYS=
INGEST_GATE_TOKEN=

# الشبكة الداخلية وعنوان الواجهة عليها (يُغيَّران معًا إن تعارض النطاق مع شبكة على الخادم)
PREVIEW_SUBNET=10.211.47.0/24
PREVIEW_EDGE_IP=10.211.47.10
# tusd والبوابة بعنوانين ثابتين: الخادم يقبل /internal منهما وحدهما، والبوابة إلى /internal/ingest/ فقط
PREVIEW_TUSD_IP=10.211.47.12
PREVIEW_GATE_IP=10.211.47.13

# الحسابات التجريبية (seed-preview.sh): بريد بنطاق .invalid، وكلمة سر عشوائية تُكتب هنا ولا تُطبع
PREVIEW_SUPERVISOR_EMAIL=
PREVIEW_SUPERVISOR_PASSWORD=
PREVIEW_EDITOR_EMAIL=
PREVIEW_EDITOR_PASSWORD=
PREVIEW_REPORTER_EMAIL=
PREVIEW_REPORTER_PASSWORD=
