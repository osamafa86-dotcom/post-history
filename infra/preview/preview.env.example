# متغيرات المعاينة الخفيفة (ADR 0023). معاينة فقط، لا تُنقل إلى التجربة. لا قيمة هنا: gen-env.sh يولّد .env بجانب هذا الملف
# مرة على الخادم (أسرار عشوائية، صلاحية 0600، لا تُطبع)، وseed-preview.sh يضيف كلمات سر الحسابات التجريبية إليه.
# النطاق في .env وحده: المستودع عام، فلا اسم نطاق ولا عنوان خادم فيه.
PREVIEW_DOMAIN=

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_UPLOADS=
S3_BUCKET_MEDIA=
JWT_SECRET=
FIELD_ENCRYPTION_KEY=
TUSD_HOOK_SECRET=
WEB_SESSION_KEY=
# الرفع من الحاسوب: مفتاح توقيع رمز ingest (ES256، PKCS#8 base64) ومفتاحه العام للبوابة (kid:SPKI)، وسر البوابة نحو الخادم
INGEST_TOKEN_SIGNING_KEY=
INGEST_TOKEN_KEY_ID=
INGEST_TOKEN_PUBLIC_KEYS=
INGEST_GATE_TOKEN=
# عامل الوسائط (ADR 0092، gen-env.sh --add-media): رمزه نحو /internal/media، ومستخدمه في MinIO (قراءة الرفع وكتابة derived/ فقط)
MEDIA_WORKER_TOKEN=
S3_MEDIA_ACCESS_KEY=
S3_MEDIA_SECRET_KEY=
# نسخ قالب «مواد متداولة» (ملحق ADR 0092، gen-env.sh --add-render): مستخدم media-render في MinIO (قراءة الرفع وكتابة
# derived/*/*/renders/ فقط)؛ رمزه نحو /internal/media هو MEDIA_WORKER_TOKEN
S3_RENDER_ACCESS_KEY=
S3_RENDER_SECRET_KEY=
# مستخدما tusd والخادم في MinIO (gen-env.sh --add-storage): tusd يقرأ ويكتب حاوية الرفع وحدها، والخادم يقرأ الحاويتين ويحذف
# كائنات tus بلا كتابة ولا إدارة. S3_ACCESS_KEY/S3_SECRET_KEY أعلاه جذر MinIO لـ minio-init وحده.
S3_TUSD_ACCESS_KEY=
S3_TUSD_SECRET_KEY=
S3_API_ACCESS_KEY=
# سر مستخدم الخادم في MinIO (gen-env.sh --add-storage)
S3_API_SECRET_KEY=

# الشبكة الداخلية وعنوان الواجهة عليها (يُغيَّران معًا إن تعارض النطاق مع شبكة على الخادم)
PREVIEW_SUBNET=10.211.47.0/24
PREVIEW_EDGE_IP=10.211.47.10
# tusd والبوابة بعنوانين ثابتين: الخادم يقبل /internal منهما وحدهما، والبوابة إلى /internal/ingest/ فقط
PREVIEW_TUSD_IP=10.211.47.12
PREVIEW_GATE_IP=10.211.47.13
# عامل الوسائط بعنوان ثابت: الخادم يقبل منه /internal/media/ وحده
PREVIEW_MEDIA_IP=10.211.47.14
# media-render بعنوان ثابت: الخادم يقبل منه /internal/media/renders/ و/internal/media/files/ وحدهما
PREVIEW_RENDER_IP=10.211.47.15
# حارس القرص (ADR 0092): لا مهمة وسائط جديدة والمساحة الحرة على قرص الحجوم دون هذا (GiB)؛ فارغ = 8. ولا نسخة قالب جديدة
# والمساحة الحرة دون هذا + حجم أصلها + 1 GiB (ملحق ADR 0092)
PREVIEW_MEDIA_MIN_FREE_GIB=

# الحسابات التجريبية (seed-preview.sh): بريد بنطاق .invalid، وكلمة سر عشوائية تُكتب هنا ولا تُطبع
PREVIEW_SUPERVISOR_EMAIL=
PREVIEW_SUPERVISOR_PASSWORD=
PREVIEW_EDITOR_EMAIL=
PREVIEW_EDITOR_PASSWORD=
PREVIEW_REPORTER_EMAIL=
PREVIEW_REPORTER_PASSWORD=
