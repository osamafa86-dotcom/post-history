# @EDGE_IP@ = عنوان هذه الحاوية على الشبكة الداخلية (PREVIEW_EDGE_IP)، و@MEDIA_BUCKET@ = حاوية المشتقات (S3_BUCKET_MEDIA)، يكتبهما
# أمر البدء.
# المنابع بأسماء فريدة على الشبكات الداخلية (ph-preview-*): هذه الحاوية على deploy_default أيضًا، والاسم القصير قد يُحل هناك.

# الويب عبر Caddy الخادم المشترك: لا فهرسة، وشريط «معاينة» في كل صفحة HTML.
server {
    listen 8080;
    location = /robots.txt {
        add_header X-Robots-Tag "noindex, nofollow" always;
        default_type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }
    # الرفع من الحاسوب (#202): tus على أصل المعاينة نفسه، فلا CORS. البوابة تتحقق من رمز ingest وحالة الجلسة قبل tusd.
    location /files/ {
        client_max_body_size 100m;
        set $ingest http://ph-preview-ingest:8080;
        proxy_pass $ingest;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_set_header Host $host;
        add_header X-Robots-Tag "noindex, nofollow" always;
    }
    # واجهة الخادم العلنية لبناء iOS التجريبي (ADR 0077): /v1/ كما وصل، بلا إعادة كتابة مسار ولا بادئة (الخادم يخدم تحت /v1 مباشرة،
    # وproxy_pass بمتغير ودون مسار يمرر الطلب الأصلي بكامله). المنبع باسم الشبكة الثانية public-api لا الداخلية: يرى الخادم هذه
    # الطلبات من عنوان للحافة ليس في BFF_SOURCE_ADDRESSES، فلا رمز ويب ولا عنوان عميل من المتصل، وكل المتصلين علنًا في سلة
    # حد معدل واحدة. بلا sub_filter (الشريط للصفحات وحدها)، وجسم JSON صغير. /health وما تحت /internal لا يمران من هنا.
    location /v1/ {
        client_max_body_size 1m;
        client_body_timeout 15s;
        set $api_public http://ph-preview-api-public:3000;
        proxy_pass $api_public;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 60s;
        add_header X-Robots-Tag "noindex, nofollow" always;
    }
    # روابط القراءة الموقّعة لمشتقات عامل الوسائط (ADR 0092): الخادم يوقّعها لأصل المعاينة نفسه (S3_PUBLIC_ENDPOINT)، فتمر هنا إلى
    # MinIO والمضيف كما وصل (التوقيع يشمله). القراءة وحدها، ولمسارات ثابتة لكل ملف: النسخة الخفيفة والملصق، ونسخة قالب «مواد
    # متداولة» أو «الشاهد» تحت renders/<النسخة>/ (ملحق ADR 0092، وADR 0109)، بمعرّفات بصيغة UUID؛ ما سواها (حاوية الرفع وملفات .info وأي كائن آخر) لا يطابق فيذهب إلى تطبيق الويب. MinIO يرفض كل طلب بلا توقيع صالح
    # لهذا الكائن بعينه وفي مدته (≤ 10 دقائق)، والخادم لا يوقّع إلا مشتقًا verified لمادة يراها المتصل. لا ترويسة Authorization
    # ولا كعكة تمر، ولا تخزين عند وكيل أمامي، وبلا تخزين مؤقت هنا (الملف يتدفق بطلبات Range للمشغّل).
    location ~ "^/@MEDIA_BUCKET@/derived/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/(proxy-480p\.mp4|poster\.jpg|renders/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/(circulated|witness)-(vertical|horizontal|square)\.mp4)$" {
        limit_except GET { deny all; }
        if ($request_uri ~ "^[^?]*(%|//|\.\.)") { return 400; }
        set $minio http://ph-preview-minio:9000;
        proxy_pass $minio;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        proxy_buffering off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_hide_header Cache-Control;
        proxy_hide_header Set-Cookie;
        add_header Cache-Control "private, no-store, max-age=0" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Robots-Tag "noindex, nofollow" always;
    }
    location / {
        set $web_app http://ph-preview-web-app:3100;
        proxy_pass $web_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # sub_filter يعمل على جسم غير مضغوط.
        proxy_set_header Accept-Encoding "";
        proxy_read_timeout 120s;
        add_header X-Robots-Tag "noindex, nofollow" always;
        sub_filter_once on;
        sub_filter '</body>' '<div role="status" lang="ar" dir="rtl" style="position:fixed;inset-block-end:0;inset-inline:0;z-index:2147483647;padding:4px 8px;background:#7a1f1f;color:#fff;font:600 13px/1.4 system-ui,sans-serif;text-align:center">معاينة: بيانات وحسابات تجريبية فقط، ومعالجة محدودة (نسخة خفيفة ومصغّرة) · <span lang="en" dir="ltr">Preview: test data and accounts only; limited processing (light copy and thumbnail)</span></div></body>';
    }
}

# الخادم للـBFF وحده: TLS داخلي (الـBFF يشترط https إلى الخادم)، على عنوان الشبكة الداخلية لا على deploy_default.
server {
    listen @EDGE_IP@:8443 ssl;
    server_name api.lib.internal;
    ssl_certificate /tls/api.crt;
    ssl_certificate_key /tls/api.key;
    ssl_protocols TLSv1.3;
    location / {
        set $api http://ph-preview-api:3000;
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_read_timeout 60s;
    }
}
