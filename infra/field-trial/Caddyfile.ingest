# الوكيل الأمامي لنطاق ingest في بيئة التجربة (ADR 0011، 0013): TLS بشهادة ACME تلقائية على INGEST_IP وحده،
# في نسخة Caddy مستقلة عن الرئيسي (مخزن شهادات منفصل). لا يوجَّه إلا /files/ إلى بوابة الرمز.
{
	email {$ACME_EMAIL}
	admin off
	{$CADDY_GLOBAL_EXTRA}
	# سجل الأخطاء (الافتراضي) يحمل الطلب كاملًا حين يفشل وكيل عكسي: ترويساته (الرموز) وعنوان العميل. يُرشَّح كالوصول.
	log default {
		output stdout
		format filter {
			request>headers delete
			request>remote_ip delete
			request>client_ip delete
			request>remote_port delete
			request>uri regexp (/files/)[^?]*|\?.* $1-
			resp_headers delete
		}
	}
}

{$INGEST_DOMAIN} {
	bind {$INGEST_IP}
	handle /files/* {
		# No proxy in front of this name: the peer is the client. X-Forwarded-For is replaced by it, never passed through,
		# so a client cannot pick the gate's rate-limit bucket.
		reverse_proxy 127.0.0.1:{$INGEST_PORT} {
			flush_interval -1
			header_up X-Forwarded-For {remote_host}
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
		}
	}
	handle {
		respond 404
	}
	log {
		output stdout
		format filter {
			request>headers delete
			request>remote_ip delete
			request>client_ip delete
			request>remote_port delete
			resp_headers delete
			# معرّف الرفع في /files/<id> قدرة حاملة (SEC-06)، والاستعلام قد يحمل ما يرسله العميل: يُحذفان من السجل.
			request>uri regexp (/files/)[^?]*|\?.* $1-
		}
	}
}
