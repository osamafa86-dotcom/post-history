# متغيرات بيئة التجربة (ADR 0013): الأسماء بلا قيم. القيم في ملف SOPS بمستودع التشغيل، تُفك على المضيف إلى
# /run/post-history/trial.env (tmpfs، root، 0400). trial.sh يقرأ infra/compose/.env.example أولًا (المنافذ وأسماء
# الحاويات، بلا أسرار) ثم هذا الملف فوقه، فكل سر في infra/compose/.env.example يُعطى قيمته هنا أيضًا.

# النطاقان على عنوانين مختلفين (ADR 0011): الرئيسي خلف Cloudflare، وingest بلا وكيل على عنوانه.
MAIN_DOMAIN=
INGEST_DOMAIN=
MAIN_IP=
INGEST_IP=
ACME_EMAIL=
# نطاقات Cloudflare مفصولة بمسافة (https://www.cloudflare.com/ips/): Caddy يقبل CF-Connecting-IP منها وحدها.
CLOUDFLARE_CIDRS=
# عنوان بوابة شبكة default وحده (الافتراضي 172.30.240.1/32)؛ لا نطاق أوسع، وإلا زوّرت حاوية أخرى عنوان العميل.
TRUSTED_PROXY_CIDRS=172.30.240.1/32
# فارغ في الإنتاج. local_certs للاختبار فقط (شهادات من سلطة Caddy المحلية).
CADDY_GLOBAL_EXTRA=

# أسرار الأساس (infra/compose/.env.example): تُعطى قيمها هنا
POSTGRES_PASSWORD=
REDIS_PASSWORD=
S3_SECRET_KEY=
TUSD_HOOK_SECRET=
JWT_SECRET=
FIELD_ENCRYPTION_KEY=
FIELD_ENCRYPTION_KEY_VERSION=
BREAK_GLASS_TOKEN_SHA256=
MEDIA_WORKER_TOKEN=
S3_MEDIA_ACCESS_KEY=
S3_MEDIA_SECRET_KEY=
UPLOAD_VERIFIER=external

# بوابة ingest: المفاتيح العامة بمعرّفاتها (kid:SPKI base64، مفصولة بفاصلة أثناء التدوير، ADR 0011)، والخادم يوقّع
# بالخاص المقابل (PKCS#8 base64) ومعرّفه
INGEST_TOKEN_PUBLIC_KEYS=
INGEST_TOKEN_SIGNING_KEY=
INGEST_TOKEN_KEY_ID=
INGEST_PORT=8443
# سر البوابة نحو الخادم لفحص حالة الجلسة (SEC-01)
INGEST_GATE_TOKEN=
# ingest مطلوب (الافتراضي في docker-compose.trial.yml). إطفاؤه (false) بقرار مكتوب فقط، ويُذكر رقمه هنا.
INGEST_REQUIRED=true
# شهادة الجهاز: production افتراضيًا. App Attest (<TeamID>.<BundleID>) وPlay Integrity (الحزمة، وبصمات شهادة التوقيع،
# وحساب الخدمة base64)؛ واحد منهما على الأقل وإلا لا يحصل جهاز على رمز ingest.
APP_ATTEST_APP_ID=
PLAY_INTEGRITY_PACKAGE_NAME=
PLAY_INTEGRITY_CERT_SHA256=
PLAY_INTEGRITY_SERVICE_ACCOUNT=

# مزوّد الدفع التجريبي (ADR 0032): sandbox في التجربة لشراء بلا مال حقيقي، أو none. DEPLOY_STAGE وPAYMENT_SANDBOX_ALLOWED
# ثابتان في docker-compose.trial.yml. سر توقيع الإشعار ≥ 32 حرفًا.
PAYMENT_PROVIDER=sandbox
SANDBOX_WEBHOOK_SECRET=

# النسخ الاحتياطي: مجلد على قرص منفصل عن بيانات Docker، وشهادة المستلم العامة (المفتاح الخاص غير متصل)
BACKUP_PG_PASSWORD=
S3_BACKUP_ACCESS_KEY=
S3_BACKUP_SECRET_KEY=
BACKUP_DIR=/srv/post-history/backups
BACKUP_RECIPIENT_CERT=/etc/post-history/backup-recipient.crt
BACKUP_HOUR_UTC=2
BACKUP_KEEP_DAYS=14
# مزوّد ثانٍ بقفل كائنات (اختياري في التجربة، إلزامي قبل الإطلاق)
BACKUP_REMOTE_URL=
BACKUP_REMOTE_ACCESS_KEY=
BACKUP_REMOTE_SECRET_KEY=
BACKUP_REMOTE_BUCKET=
# أرشفة WAL المستمرة بـ WAL-G (ADR 0051): فقد ≤ 15 دقيقة. مطفأة في التجربة مقبول (فقد حتى 24 ساعة)، وشرط قبل المرحلة
# التجارية. حاوية بقفل compliance لدى المزوّد الثاني ومفتاح كتابة فقط، والمفتاح العام PGP وحده على المضيف؛ الخاص للاستعادة
# عند المالك (infra/backup/pitr-drill.sh).
WALG_ARCHIVE_MODE=
WALG_S3_PREFIX=
WALG_S3_ENDPOINT=
WALG_S3_REGION=
WALG_ACCESS_KEY=
WALG_SECRET_KEY=
WALG_PG_PASSWORD=
WALG_PUBLIC_KEY=/etc/post-history/walg-public.asc

# المراقبة وتتبّع الأخطاء (ADR 0027، 0029): مشروعان مستقلان يقرآن هذا الملف (infra/observability/stack.sh).
GRAFANA_ADMIN_PASSWORD=
GLITCHTIP_DB_PASSWORD=
GLITCHTIP_SECRET_KEY=

# نافذة مفتاح الاختبار qa- (ADR 0022): لا تُضبط هنا ولا في الملف المختوم. infra/field-trial/qa-window.sh يكتبها في الملف
# المفكوك (tmpfs) ويزيلها، وpreflight يرسب إن وُجدت بلا --qa-window.
# INGEST_QA_PUBLIC_KEY=  INGEST_QA_KEY_EXPIRES=  ACCEPTANCE_UPLOADER_USER_ID=
