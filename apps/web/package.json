{
  "name": "@post-history/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1 --port 3100",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1 --port 3100",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "generate:client": "bash scripts/generate-client.sh",
    "check:client": "bash scripts/generate-client.sh --check",
    "test:conformance": "node --import tsx scripts/form-conformance.ts && node ../../tools/acceptance/form-conformance/run.mjs --compare=.artifacts/web.json",
    "measure": "node --import tsx scripts/measure-inbox.ts",
    "measure:upload": "node --import tsx scripts/measure-upload.ts",
    "generate:player": "node scripts/player-css.mjs",
    "check:player": "node scripts/player-css.mjs --check",
    "measure:player": "node scripts/player-bench/measure.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@uppy/core": "6.2.0",
    "@uppy/tus": "6.0.0",
    "ioredis": "6.0.0",
    "next": "16.4.2",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shaka-player": "5.3.2"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "js-yaml": "4.3.2",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
