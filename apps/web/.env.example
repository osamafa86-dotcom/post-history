# خادم الويب فقط؛ لا تستخدم NEXT_PUBLIC لهذه القيم.
WEB_ORIGIN=http://127.0.0.1:3100
API_BASE_URL=http://127.0.0.1:3000/v1
WEB_REDIS_URL=redis://127.0.0.1:6379/1
# مفتاح AES-256 عشوائي مشفّر بـ base64؛ مثال التوليد: openssl rand -base64 32
WEB_SESSION_KEY=
# يجب أن تكون false في النشر؛ للاستضافة المحلية عبر HTTP فقط.
WEB_ALLOW_INSECURE_LOCALHOST=true
# أصول تخزين المشتقات التابعة للمشروع فقط، مفصولة بفواصل؛ الفراغ يعطّل المعاينات.
WEB_MEDIA_ORIGINS=http://127.0.0.1:9000
# الحافة أمامه تستبدل X-Forwarded-For بعنوان العميل وحده: يمرَّر إلى الخادم في X-Client-Address لحد معدل الدخول
# (الخادم يقبله من عنوان الـBFF الثابت BFF_SOURCE_ADDRESSES وحده). true في النشر خلف الحافة فقط
WEB_TRUST_FORWARDED_FOR=false
# أصول نقاط tus التي يرفع إليها المتصفح مباشرة (#88)، مفصولة بفواصل؛ الفراغ يعطّل الرفع من الحاسوب.
WEB_TUS_ORIGINS=http://127.0.0.1:8080
# أصول صفحة الدفع المستضافة، مفصولة بفواصل؛ الفراغ يعطّل الدفع. المزوّد التجريبي: أصل الخادم الذي يقدّم صفحته.
# Stripe بوضع الاختبار وحده: أصل صفحته المستضافة كما في README (الـBFF لا يقبل رابط Stripe على غير ذلك الأصل).
WEB_CHECKOUT_ORIGINS=
