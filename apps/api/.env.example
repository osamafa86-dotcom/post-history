# متغيرات الخادم (apps/api). الأسماء فقط؛ القيم من الخزنة في الإنتاج ومن .env محليًا (لا يُرفع).
# المطلوب بلا افتراضي معلَّم بـ (مطلوب). التحقق في src/config/config.ts؛ الخادم يرفض البدء إن نقص شيء.

NODE_ENV=
HOST=
PORT=
LOG_LEVEL=

# الوكلاء العكسيون الموثوقون لـ X-Forwarded-For، CIDR مفصولة بفواصل: نطاقات Cloudflare المنشورة
# (https://www.cloudflare.com/ips/). فارغ = لا ثقة، وreq.ip = عنوان المقبس.
TRUSTED_PROXY_CIDRS=
# عناوين المقبس المسموح لها بـ /internal/* (خطّافات tusd)، مثل شبكة compose الداخلية. الافتراضي الحلقة المحلية فقط.
INTERNAL_ALLOWED_CIDRS=
# مصادر /internal/* المقيّدة بمسارات صريحة: CIDR=/internal/<path>/[|/internal/<path>/] مفصولة بـ ;
# (مثل عنوان بوابة ingest الثابت=/internal/ingest/). العنوان المطابق لا يصل إلى غير بادئاته (403). فارغ = لا تقييد
INTERNAL_SOURCE_PATHS=
# عنوان الـBFF الثابت (/32)؛ منه وحده تُقبل ترويسة X-Client-Address لحد معدل الدخول. فارغ = تُتجاهل دائمًا
BFF_SOURCE_ADDRESSES=

# (مطلوب) دور التشغيل لا دور الترحيل (SEC-05)
DATABASE_URL=
DATABASE_POOL_MAX=
# مهلة الاستعلام الواحد، ومهلة المعاملة المفتوحة بلا استعلام، بالمللي ثانية (افتراضي 30000 و60000؛ 0 = بلا مهلة من الخادم).
# ما يتجاوزهما يُلغى ويرد الطلب 503 مع Retry-After (ADR 0028)
DATABASE_STATEMENT_TIMEOUT_MS=
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=

# (مطلوب) Redis المشترك بين النسخ (حد معدل الدخول)
REDIS_URL=

# (مطلوب) سر توقيع رمز الوصول HS256، ≥ 32 حرفًا عشوائيًا
JWT_SECRET=
# عمر رمز الوصول بالثواني (60–900، SEC-02) وعمر رمز التحديث
ACCESS_TOKEN_TTL_SECONDS=
REFRESH_TOKEN_TTL_SECONDS=
# (مطلوب) مفتاح التشفير على مستوى الحقل AES-256-GCM، 32 بايت base64 (مثل users.totp_secret_enc)
FIELD_ENCRYPTION_KEY=
# رقم إصدار المفتاح الحالي (1–255، افتراضي 1). للتدوير: القديم ورقمه في *_PREVIOUS (قراءة فقط)، والجديد برقم جديد
FIELD_ENCRYPTION_KEY_VERSION=
FIELD_ENCRYPTION_KEY_PREVIOUS=
FIELD_ENCRYPTION_KEY_PREVIOUS_VERSION=

# طلب استعادة الحساب ينتظر اعتماد المشرف هذه المدة بالثواني (افتراضيًا يوم)
RECOVERY_REQUEST_TTL_SECONDS=
# صلاحية رمز إعادة التعيين بعد اعتماد الاستعادة (300..86400، الافتراض 43200)
RECOVERY_RESET_TOKEN_TTL_SECONDS=
# صلاحية رابط إعادة التعيين الذي يصدره مدير النظام (300..86400، الافتراض 3600)
PASSWORD_RESET_LINK_TTL_SECONDS=
# مفاتيح المرور (WebAuthn): نطاق الطرف المعتمد ومصادر الويب المسموحة مفصولة بفاصلة (https، ومضيف كل مصدر هو النطاق أو تحته).
# غير مضبوط = مفاتيح المرور معطّلة. لا نطاق في الشفرة.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGINS=
# الاسم الذي يعرضه المتصفح عند إنشاء المفتاح (افتراضي PostHistory)
WEBAUTHN_RP_NAME=
# عمر تحدي WebAuthn بالثواني (60..600، الافتراض 300)، وحد التحديات لكل حساب في نافذة الدخول (افتراضي 30)
PASSKEY_CHALLENGE_TTL_SECONDS=
PASSKEY_RATE_LIMIT_MAX=
# بصمة SHA-256 (hex) لرمز تشغيل الطوارئ في الخزنة لأمر CLI اعتماد استعادة مدير النظام؛ الرمز نفسه لا يوضع هنا
BREAK_GLASS_TOKEN_SHA256=

# حد المحاولات الفاشلة لكل (بريد، عنوان) ولكل عنوان خلال النافذة
LOGIN_RATE_LIMIT_MAX=
LOGIN_RATE_LIMIT_IP_MAX=
LOGIN_RATE_LIMIT_WINDOW_SECONDS=
# عدّادا فشل لكل حساب لكلمة المرور ولرمز TOTP، مستقلان عن العنوان (ADR 0117): محاولات مجانية (5)، ثم تأخير يتضاعف من الأساس
# (1 ث) حتى السقف (900 ث)، ويُنسى العدّاد بعد مدة بلا فشل (86400 ث)
LOGIN_BACKOFF_FREE_ATTEMPTS=
LOGIN_BACKOFF_BASE_SECONDS=
LOGIN_BACKOFF_MAX_SECONDS=
LOGIN_BACKOFF_RESET_SECONDS=

# (مطلوب) رمز مسار خطّاف tusd (32–128 حرفًا)؛ القيمة نفسها في TUSD_HOOK_URL لدى tusd (ADR SEC-06)
TUSD_HOOK_SECRET=
# تدوير رمز الخطّاف: الرمز السابق ووقت انتهاء قبوله (ISO 8601، مثل 2026-11-01T12:00:00Z)؛ يُضبطان معًا
TUSD_HOOK_SECRET_PREVIOUS=
TUSD_HOOK_SECRET_PREVIOUS_UNTIL=
# بادئة مفاتيح الكائنات في tusd (-s3-object-prefix)، والحاوية التي يكتب فيها
TUSD_OBJECT_PREFIX=
# true فقط إن كان post-create ضمن -hooks-enabled-events لدى tusd (افتراضي false)
TUSD_POST_CREATE_HOOK=
# مدة حجز الجلسة بين pre-create وpost-create بالثواني (افتراضي 60)؛ tusd لا يرفض المعرّف المكرّر
TUSD_PRE_CREATE_RESERVATION_SECONDS=
# (مطلوب)
S3_BUCKET_UPLOADS=
# حاوية مشتقات عامل الوسائط (افتراضي media، كما في infra/compose)
S3_BUCKET_MEDIA=
# ما يُعاد للعميل عند إنشاء جلسة رفع: نقطة tus العامة، وحجم الجزء الثابت (≥ 5 MiB، كما في tusd)، وعمر الجلسة ورمزها
TUS_PUBLIC_ENDPOINT=
TUSD_PART_SIZE_BYTES=
UPLOAD_SESSION_TTL_SECONDS=
# عمر رمز الرفع بالثواني (افتراضي 3600، لا يتجاوز عمر الجلسة)؛ يلزم لبدء الرفع فقط
UPLOAD_TOKEN_TTL_SECONDS=
# مسار الرفع: tusd (افتراضي) أو direct (العميل يعلن الاكتمال بـ POST /uploads/{id}/complete)
UPLOAD_PATH=
# اسم الشبكة في نسب المواد بالكتالوج (افتراضي Palestine Post)
CATALOG_CREDIT=
# حد حجم الملف الواحد بالبايت عند إنشاء جلسة الرفع (422 إن تجاوزه size_bytes)، ≤ 2 GiB؛ إلزامي مع NODE_ENV=production أو DEPLOY_STAGE=trial|production (ADR 0115)، وفارغ محليًا = سقف العقد. يطابق -max-size في tusd
UPLOAD_MAX_BYTES=
# حصة كل مستخدم من جلسات الرفع المفتوحة وبايتاتها المنتظرة (ADR 0115)؛ الافتراضي 60 جلسة و40 GiB، وتجاوزها 429
UPLOAD_MAX_OPEN_SESSIONS_PER_USER=
UPLOAD_MAX_PENDING_BYTES_PER_USER=
# رفض إنشاء جلسة رفع بلا client_sha256 (422)؛ افتراضيًا true مع عقد v0.1
UPLOAD_REQUIRE_CLIENT_SHA256=
# تسوية جلسات in_progress التي ضاع post-finish لها (تحتاج التخزين): التفعيل، الفاصل، مهلة الركود بالثواني، حجم الدفعة
UPLOAD_RECONCILE_ENABLED=
UPLOAD_RECONCILE_INTERVAL_MS=
UPLOAD_RECONCILE_STALE_SECONDS=
UPLOAD_RECONCILE_BATCH=
# التحقق من الملفات المرفوعة: in_process (افتراضي، الخادم يحسب SHA-256 من التخزين) أو external (عامل الوسائط)
UPLOAD_VERIFIER=
VERIFY_POLL_INTERVAL_MS=
# (مطلوب في الإنتاج مع UPLOAD_VERIFIER=external) رمز عامل الوسائط لنقاط /internal/media/* بترويسة Bearer، منفصل عن رمز tusd
MEDIA_WORKER_TOKEN=
# رمز بوابة ingest لفحص /internal/ingest/session-status بترويسة Bearer (إن ضُبط يُرفض الفحص بدونه)
INGEST_GATE_TOKEN=
# حساب القبول (uuid) الذي تُقبل جلساته برمز مفتاح qa على فحص البوابة (key_class=qa)؛ فارغ = رفض دائم
ACCEPTANCE_UPLOADER_USER_ID=
# رمز عامل التفريغ المحلي (transcript/captions على نقطة المشتقات وحدها)، مختلف عن MEDIA_WORKER_TOKEN
AI_WORKER_TOKEN=
# طول طابوري عامل الوسائط media:events وmedia:renders التقريبي (افتراضي 100000)
MEDIA_STREAM_MAXLEN=
# نسخ قالب «مواد متداولة» (ADR 0091): true يفتح /materials/{id}/renders (افتراضي false؛ مطفأ في الإنتاج)
MEDIA_ENABLE_RENDERS=
# حدّ مدة أصل النسخة بالمللي ثانية (افتراضي 300000، مؤقت حتى القياس)
MEDIA_RENDER_MAX_SOURCE_MS=
# عدد البصمات المحسوبة معًا (افتراضي 4، حتى 32)؛ يجب أن يقل عن DATABASE_POOL_MAX
VERIFY_CONCURRENCY=
# خيوط حساب SHA-256 (افتراضي عدد الأنوية ناقص واحد)
VERIFY_HASH_THREADS=
# (مطلوب مع in_process) قراءة التخزين: MinIO محليًا، R2 في الإنتاج
S3_ENDPOINT=
# النقطة التي يصلها العميل لروابط التنزيل الموقّعة (غير مضبوطة = S3_ENDPOINT)
S3_PUBLIC_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# حجز الإنتاج: يُحرَّر بعد هذا الخمول بالثواني (افتراضيًا 900)، والمؤقت الذي يحرّره كل دقيقة
RESERVATION_IDLE_SECONDS=
RESERVATION_SWEEP_ENABLED=
# الكنس الدوري (ADR 0116): مفاتيح منع التكرار المنتهية، ورموز التحديث الميتة بعد 30 يومًا، واسم الملف على الجهاز في جلسة الرفع
# المنتهية بعد 30 يومًا، والإشعارات المقروءة بعد 180 يومًا؛ كل ساعة بدفعات 5000. false يطفئه
RETENTION_SWEEP_ENABLED=
RETENTION_SWEEP_INTERVAL_MS=
RETENTION_SWEEP_BATCH=
RETENTION_REFRESH_TOKEN_DAYS=
RETENTION_UPLOAD_FILENAME_DAYS=
RETENTION_READ_NOTIFICATION_DAYS=

# مهلة الإقرار قبل تصعيد مهمة بالثواني (عاجل 600، مهم 3600 افتراضيًا) وتواتر فحصها
ESCALATION_URGENT_SECONDS=
ESCALATION_IMPORTANT_SECONDS=
ESCALATION_POLL_INTERVAL_MS=

# لغة عناوين إشعارات صندوق الوارد: ar (افتراضي) أو en
NOTIFICATION_LOCALE=

OUTBOX_DISPATCHER_ENABLED=
OUTBOX_POLL_INTERVAL_MS=
OUTBOX_BATCH_SIZE=
# حدث يفشل نشره هذا العدد من المرات يُعلَّم ميتًا ويخرج من طابور المُرسل (افتراضي 20، نحو ساعة من الفشل المتصل)
OUTBOX_MAX_ATTEMPTS=

# SEC-07 (ADR 0011): شهادة الجهاز ونطاق ingest. off (افتراضي) = المسارات الثلاثة 404؛ test = جذر اختبار وحكم Play غير
# موقّع (خارج الإنتاج فقط)؛ production = جذر Apple المثبّت في الكود وواجهة Google
ATTESTATION_MODE=
# App Attest: <TeamID>.<BundleID>؛ مفاتيح البيئة التطويرية مسموحة خارج الإنتاج فقط؛ جذر الاختبار PEM بترميز base64
APP_ATTEST_APP_ID=
APP_ATTEST_ALLOW_DEVELOPMENT=
APP_ATTEST_TEST_ROOT_PEM=
# Play Integrity: اسم الحزمة، وبصمات شهادة التوقيع (base64url كما يعيدها Google) مفصولة بفواصل، وحساب الخدمة
# (JSON بترميز base64، سر من SOPS) لـ decodeIntegrityToken
PLAY_INTEGRITY_PACKAGE_NAME=
PLAY_INTEGRITY_CERT_SHA256=
PLAY_INTEGRITY_SERVICE_ACCOUNT=
# حد طلبات التحدي ورموز ingest لكل مستخدم في نافذة LOGIN_RATE_LIMIT_WINDOW_SECONDS (افتراضي 60)
ATTESTATION_RATE_LIMIT_MAX=
# مفتاح توقيع رموز ingest: ES256 خاص، PKCS#8 DER بترميز base64 (سر من SOPS)، ومعرّفه kid. البوابة تحمل العام وحده
# (INGEST_TOKEN_PUBLIC_KEY). التدوير: العام الجديد في البوابة أولًا، ثم المفتاح ومعرّفه هنا، ثم يُزال العام القديم
INGEST_TOKEN_SIGNING_KEY=
INGEST_TOKEN_KEY_ID=
# عمر رمز ingest بالثواني (60–900، افتراضي 600)، ولا يتجاوز انتهاء جلسة الرفع
INGEST_TOKEN_TTL_SECONDS=
# true = جلسات tus تعلن نقطة ingest وتطلب الرمز (يتطلب ATTESTATION_MODE وINGEST_TUS_ENDPOINT)
INGEST_REQUIRED=
INGEST_TUS_ENDPOINT=

# تسليم الإشعارات بالدفع (true/false، افتراضي false)، وتواتر الطابور وحد المحاولات (افتراضي 2000 مث و6)
PUSH_DELIVERY_ENABLED=
PUSH_POLL_INTERVAL_MS=
PUSH_MAX_ATTEMPTS=
# APNs: معرّف الفريق ومعرّف المفتاح، ومفتاح .p8 بترميز base64 (سر من SOPS)، وBundle ID، والبيئة production|sandbox
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=
APNS_ENVIRONMENT=
# FCM HTTP v1: معرّف المشروع وحساب الخدمة (JSON بترميز base64، سر من SOPS)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT=
# لقطة لوحة غرفة الأخبار لكل مستخدم ونطاقه بالمللي ثانية (افتراضي 5000، حتى 5000؛ 0 = بلا لقطة)
DASHBOARD_SNAPSHOT_MS=

# مزوّد الدفع (ADR 0032): none أو sandbox (خارج الإنتاج وحده) أو stripe (وضع الاختبار وحده)؛ لا مال حقيقي
PAYMENT_PROVIDER=none
# مرحلة النشر (local|trial|production)؛ sandbox في NODE_ENV=production للتجربة وحدها مع PAYMENT_SANDBOX_ALLOWED=1
DEPLOY_STAGE=
PAYMENT_SANDBOX_ALLOWED=0
SANDBOX_WEBHOOK_SECRET=
# Stripe في وضع الاختبار: sk_test_ وحده (الحي يُرفض) وسر الويبهوك whsec_، على التجربة وحدها؛ والأصل لـ stripe-mock محليًا (في NODE_ENV=production لا يُقبل إلا عنوان Stripe الرسمي الافتراضي)
STRIPE_TEST_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=
SANDBOX_CHECKOUT_BASE_URL=
# صفحة الويب التي تعود إليها صفحة الدفع، قالبًا بـ {order_id} (إلزامي) و{locale} (لغة المشتري، ar أو en)، https إلا localhost:
# https://<الويب>/{locale}/store/orders/{order_id}?returned=1؛ فارغة = بلا عودة
SANDBOX_RETURN_URL=
# عمولة المنصة الافتراضية بأجزاء من عشرة آلاف (3000 = 30%) حتى قواعد العمولة
PLATFORM_COMMISSION_BASIS_POINTS=
# الأرباح والصرف التجريبي (ADR 0033): أيام فترة الاسترداد قبل تحرير المستحق إلى «متاح»، ودورة عامل الصرف (التحرير والقناة
# التجريبية)، والسياسة الاحتياطية بأصغر وحدة حين لا سياسة صرف لعملة (الحد الأدنى، وحد الاعتماد الثنائي، والاحتياطي بنقاط أساس)
PAYOUT_RELEASE_AFTER_DAYS=
PAYOUT_WORKER_INTERVAL_MS=
PAYOUT_DEFAULT_MINIMUM_MINOR=
PAYOUT_DEFAULT_DUAL_APPROVAL_ABOVE_MINOR=
PAYOUT_DEFAULT_RESERVE_BPS=
# رابط تنزيل حزمة الترخيص: عمره بالثواني (60–86400، افتراضيًا 600) وعدد المنح لكل ترخيص (افتراضيًا 5)
LICENSE_DOWNLOAD_URL_SECONDS=
LICENSE_DOWNLOAD_LIMIT=
# صفحة التحقق العامة من الترخيص: طلبات كل عنوان IP في نافذة LOGIN_RATE_LIMIT_WINDOW_SECONDS قبل 429
LICENSE_VERIFY_RATE_LIMIT_MAX=
