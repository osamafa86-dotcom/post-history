{
  "name": "@post-history/api",
  "private": true,
  "version": "0.1.0",
  "license": "UNLICENSED",
  "scripts": {
    "generate:api-types": "openapi-typescript ../../contracts/openapi.yaml -o src/generated/api.d.ts",
    "prebuild": "npm run generate:api-types",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "npm run generate:api-types && tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "cli:approve-admin-recovery": "node dist/cli/approve-admin-recovery.js",
    "db:migrate": "src/db/migrate.sh up",
    "db:pull": "scripts/db-pull.sh",
    "db:check-schema": "scripts/check-drizzle-schema.sh",
    "test": "npm run generate:api-types && jest --selectProjects unit",
    "test:integration": "npm run generate:api-types && jest --selectProjects integration --runInBand",
    "test:coverage": "npm run generate:api-types && jest --runInBand --coverage",
    "contract:coverage": "node scripts/contract-coverage.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.7",
    "@node-rs/argon2": "2.2.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "drizzle-orm": "0.45.4",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "jest": "30.5.2",
    "openapi-typescript": "7.13.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  }
}
