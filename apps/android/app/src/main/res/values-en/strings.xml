    <string name="setup_title">Background upload setup</string>
    <string name="setup_intro">On %1$s devices the battery manager stops apps after the screen locks, and uploads stop with them. The steps below exempt this app. The app asks for no permission; you change the settings yourself.</string>
    <string name="setup_notifications_title">Progress notification</string>
    <string name="setup_notifications_body">The app shows an ongoing notification while uploading (no file name, no title). Allow notifications so it appears.</string>
    <string name="setup_allow">Allow</string>
    <string name="setup_battery_title">Exempt from battery saving</string>
    <string name="setup_battery_body">In the list that opens choose “All apps”, find this app and choose “Don’t optimize” or “Unrestricted”.</string>
    <string name="setup_battery_body_samsung">In the list that opens choose “All”, find this app and choose “Don’t optimize”. Then do the “Sleeping apps” step.</string>
    <string name="setup_xiaomi_saver_title">App battery saver: no restrictions</string>
    <string name="setup_xiaomi_saver_body">On the app’s page choose “No restrictions” instead of “Smart” or “Battery saver”.</string>
    <string name="setup_autostart_title">Autostart</string>
    <string name="setup_autostart_body_xiaomi">Enable “Autostart” for this app in the autostart management list.</string>
    <string name="setup_autostart_body_huawei">In “App launch” turn off automatic management for this app and enable all three options (auto-launch, secondary launch, run in background).</string>
    <string name="setup_autostart_body_generic">Enable autostart or “allow background activity” for this app.</string>
    <string name="setup_samsung_sleep_title">Sleeping apps</string>
    <string name="setup_samsung_sleep_body">Open “Background usage limits”, then “Never sleeping apps”, and add this app. Make sure it is not under “Sleeping apps” or “Deep sleeping apps”.</string>
    <string name="setup_lock_title">Lock the app in recents</string>
    <string name="setup_lock_body_xiaomi">Open recents, long-press this app’s card, then tap the lock icon.</string>
    <string name="setup_lock_body_samsung">Open recents, tap the app icon above its card, then “Lock this app”.</string>
    <string name="setup_lock_body_generic">Open recents and lock this app’s card if the device offers it.</string>
