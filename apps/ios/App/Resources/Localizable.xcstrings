    "settings.appLock": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قفل التطبيق بـ Face ID أو الرمز"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock the app with Face ID or passcode"
          }
        }
      }
    },
    "settings.appLock.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُقفل التطبيق كلما خرجت منه، ويستمر الرفع في الخلفية. المسح الطارئ متاح من شاشة القفل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app locks whenever you leave it, and uploads continue in the background. Emergency wipe stays available on the lock screen."
          }
        }
      }
    },
    "settings.appLock.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن القفل: فعّل رمز الجهاز أو Face ID في الإعدادات أولًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t lock: set a device passcode or Face ID in Settings first."
          }
        }
      }
    },
    "settings.uploadOverWifiOnly": {
      "extractionState": "manual",
      "localizations": {
