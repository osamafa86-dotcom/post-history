    "revoked.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُبطلت الجلسة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Session revoked"
          }
        }
      }
    },
    "revoked.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُبطلت جلسة هذا الهاتف (من الإدارة أو من جهاز آخر). توقّف الرفع ومُحيت الرموز وحالة الرفع من هذا الجهاز. سجّل الدخول من جديد إن كان الهاتف بحوزتك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone's session was revoked (by the newsroom or from another device). Uploads stopped and the tokens and upload state were erased from this device. Sign in again if the phone is still yours."
          }
        }
      }
    },
    "revoked.signInAgain": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الدخول من جديد"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in again"
          }
        }
      }
    },
    "wipe.section": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المسح الطارئ"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Emergency wipe"
          }
        }
      }
    },
    "wipe.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحاول أولًا إبطال كل جلساتك على الخادم (ثلاث ثوانٍ على الأكثر، إن توفّر اتصال) ثم يمحو من هذا الهاتف فورًا: الجلسة ورموز الرفع وحالة الرفع والأجزاء والملفات المستوردة والمصغّرات وذاكرة الصور. لا يمس مكتبة الصور ولا ما وصل إلى الخادم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First tries to revoke all your sessions on the server (at most three seconds, if reachable), then immediately erases from this phone: the session, upload tokens, upload state, chunks, imported files, thumbnails and image caches. It does not touch the photo library or anything already on the server."
          }
        }
      }
    },
    "wipe.action": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مسح طارئ"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Emergency wipe"
          }
        }
      }
    },
    "wipe.confirm.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مسح كل بيانات التطبيق من هذا الهاتف؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase all app data from this phone?"
          }
        }
      }
    },
    "wipe.confirm.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن التراجع. ما لم يصل إلى الخادم يُفقد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This cannot be undone. Anything not yet on the server is lost."
