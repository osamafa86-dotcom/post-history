{
  "sourceLanguage": "ar",
  "version": "1.0",
  "strings": {
    "login.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الدخول"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in"
          }
        }
      }
    },
    "login.email": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البريد الإلكتروني"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Email"
          }
        }
      }
    },
    "login.password": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلمة المرور"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Password"
          }
        }
      }
    },
    "login.totp": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز التحقق (6 أرقام)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verification code (6 digits)"
          }
        }
      }
    },
    "login.totp.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المصادقة الثنائية إلزامية لكل الطاقم بعد التفعيل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two-factor authentication is mandatory for all staff once enabled."
          }
        }
      }
    },
    "login.submit": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دخول"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in"
          }
        }
      }
    },
    "auth.error.sessionExpired": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت الجلسة. سجّل الدخول من جديد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session has ended. Sign in again."
          }
        }
      }
    },
    "auth.error.totpRequired": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل رمز التحقق من تطبيق المصادقة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the verification code from your authenticator app."
          }
        }
      }
    },
    "auth.error.unauthorized": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البريد أو كلمة المرور أو رمز التحقق غير صحيح."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The email, password or verification code is incorrect."
          }
        }
      }
    },
    "auth.error.rateLimited": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محاولات كثيرة. انتظر قليلًا ثم أعد المحاولة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many attempts. Wait a moment and try again."
          }
        }
      }
    },
    "auth.error.validation": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من البيانات المدخلة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the details you entered."
          }
        }
      }
    },
    "auth.error.server": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إتمام الطلب على الخادم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server could not complete the request."
          }
        }
      }
    },
    "auth.error.transport": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا اتصال بالخادم. تحقق من الشبكة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No connection to the server. Check your network."
          }
        }
      }
    },
    "home.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "موادي"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My materials"
          }
        }
      }
    },
    "home.uploads": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرفع"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploads"
          }
        }
      }
    },
    "home.uploads.empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا عمليات رفع بعد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No uploads yet."
          }
        }
      }
    },
    "settings.session": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجلسة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Session"
          }
        }
      }
    },
    "settings.logout": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الخروج"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign out"
          }
        }
      }
    },
    "settings.logoutAll": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إنهاء كل الجلسات على كل الأجهزة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign out of all devices"
          }
        }
      }
    },
    "settings.logoutAll.confirm": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبطل هذا كل جلساتك ورموز الرفع المفتوحة على كل الأجهزة (عند فقد الهاتف)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This revokes all your sessions and open upload tokens on every device (use when a phone is lost)."
          }
        }
      }
    }
  }
}