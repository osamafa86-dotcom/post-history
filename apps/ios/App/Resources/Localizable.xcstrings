        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload over Wi‑Fi only"
          }
        }
      }
    },
    "settings.uploadOverWifiOnly.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُستخدم الخلوي ولا وضع البيانات المنخفضة. يبقى الرفع في الطابور ويستأنف من آخر ما وصل حين يتوفر Wi‑Fi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No cellular or Low Data Mode. Uploads stay queued and resume from the last byte received once Wi‑Fi is available."
          }
        }
      }
    }
  }
