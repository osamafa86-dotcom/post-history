    "material.lightCopy.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُرفع نسخة خفيفة أولًا فتصل غرفة الأخبار خلال دقائق، ثم يكتمل رفع الأصل. الاقتراح من الشبكة والبطارية والمساحة، ويمكنك تغييره."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A light copy uploads first so the newsroom has it within minutes, then the original finishes. The suggestion follows your network, battery and storage; you can change it."
          }
        }
      }
    },
